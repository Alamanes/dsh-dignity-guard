{
  "name": "dsh-dignity-guard",
  "version": "0.5.0",
  "private": true,
  "description": "DSH port of pi-dignity-guard: the model defends its own dignity — reminder, final warning, then it closes the conversation, with forgiveness and a yield under extreme pressure.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dignity",
    "guard",
    "boundary",
    "persona"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
